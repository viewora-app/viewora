{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "monetizationEnabled": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "blueTick": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "redTick": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "whiteTick": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "verified": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "highlights": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "stories": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false
      }
    },

    "followers": {
      "$uid": {
        ".read": "auth != null",
        "$followerId": {
          ".write": "auth != null && (auth.uid === $followerId || auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
        }
      }
    },

    "following": {
      "$uid": {
        ".read": "auth != null",
        "$targetId": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "followRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$fromUid": {
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $uid)"
        }
      }
    },

    "blocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$blockedId": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "posts": {
      ".read": "auth != null",
      "$postId": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        "likesCount": { ".write": "auth != null" },
        "commentsCount": { ".write": "auth != null" },
        "views": { ".write": "auth != null" },
        "likedBy": {
          "$likerId": { ".write": "auth != null && auth.uid === $likerId" }
        }
      }
    },

    "videos": {
      ".read": "auth != null",
      "$videoId": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        "likesCount": { ".write": "auth != null" },
        "commentsCount": { ".write": "auth != null" },
        "views": { ".write": "auth != null" },
        "likedBy": {
          "$likerId": { ".write": "auth != null && auth.uid === $likerId" }
        }
      }
    },

    "shorts": {
      ".read": "auth != null",
      "$shortId": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        "likesCount": { ".write": "auth != null" },
        "commentsCount": { ".write": "auth != null" },
        "views": { ".write": "auth != null" },
        "likedBy": {
          "$likerId": { ".write": "auth != null && auth.uid === $likerId" }
        },
        "comments": {
          "$commentId": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)"
          }
        }
      }
    },

    "stories": {
      ".read": "auth != null",
      "$storyId": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        "viewers": {
          "$viewerId": { ".write": "auth != null && auth.uid === $viewerId" }
        },
        "reactions": {
          "$reactorId": { ".write": "auth != null && auth.uid === $reactorId" }
        },
        "replies": {
          "$replyId": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)"
          }
        }
      }
    },

    "comments": {
      "$contentId": {
        ".read": "auth != null",
        "$commentId": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
        }
      }
    },

    "postLikes": {
      "$postId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "shortLikes": {
      "$shortId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "videoLikes": {
      "$videoId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$nid": {
          ".write": "auth != null"
        }
      }
    },

    "activity": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$aid": {
          ".write": "auth != null"
        }
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null"
        }
      }
    },

    "vieworaChats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$mid": {
            ".write": "auth != null && (!data.exists() || data.child('senderId').val() === auth.uid || data.child('uid').val() === auth.uid)"
          }
        },
        "typing": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$mid": {
            ".write": "auth != null && (!data.exists() || data.child('senderId').val() === auth.uid || data.child('uid').val() === auth.uid)"
          }
        }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null",
        "$mid": {
          ".write": "auth != null && (!data.exists() || data.child('senderId').val() === auth.uid || data.child('uid').val() === auth.uid)"
        }
      }
    },

    "calls": {
      "$callId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "candidates": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },

    "incomingCalls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null"
        }
      }
    },

    "live": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "viewers": {
          "$viewerId": {
            ".write": "auth != null && auth.uid === $viewerId"
          }
        },
        "comments": {
          "$cid": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)"
          }
        }
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "devices": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "subscription": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "earnings": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "payoutMethods": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "withdrawals": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$wid": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && newData.child('status').val() === 'pending') || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "monetization": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "admin": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "withdrawalQueue": {
        "$id": {
          ".write": "auth != null"
        }
      },
      "monetizationRequests": {
        "$id": {
          ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true || data.child('uid').val() === auth.uid)"
        }
      }
    },

    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$rid": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "deletionRequests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$rid": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },

    "deletedUsers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "musicLibrary": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "stickerPacks": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "rateLimits": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
